{
  "name": "obsidian-ima-plugin",
  "version": "1.0.0",
  "description": "IMA 知识库同步到 Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ima",
    "knowledge-base",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.13.12",
    "obsidian": "latest",
    "tslib": "2.3.1",
    "typescript": "4.4.4"
  }
}